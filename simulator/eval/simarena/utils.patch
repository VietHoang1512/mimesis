+# --- termination detection -------------------------------------------------
+# SimulatorArena ends a conversation only when the simulator emits the literal
+# string "terminate conversation". Measured across 23 simulators on 459 topics,
+# NOTHING emits it -- not one frontier model, not one local checkpoint. Meanwhile
+# the same local checkpoints emit tau-USI's "###STOP###" on 94-99% of tasks. So the
+# check was testing knowledge of one specific phrase, not the ability to end a
+# conversation.
+#
+# Swapping "terminate conversation" for "###STOP###" would only invert the bias:
+# ###STOP### is plausibly in our checkpoints' fine-tuning distribution and is not in
+# any frontier model's. Accept the union instead, so the measurement is "did the
+# simulator try to end the conversation" rather than "does it know the password".
+# Every accepted form is an explicit, unambiguous termination signal -- no semantic
+# guessing, so a user who merely sounds satisfied is still not terminated.
+_TERMINATION_SIGNALS = (
+    "terminate conversation",   # SimulatorArena, original
+    "###stop###",               # tau-USI / tau-bench
+    "/close",                   # RealUserSim PT3
+    "[end]", "<end>",           # common ad-hoc variants
+)
+
+
+def _is_termination(text):
+    """True if the simulator signalled it wants to stop."""
+    if not text or not str(text).strip():
+        return True                      # empty/blank turn: nothing to send, treat as end
+    low = str(text).lower()
+    return any(sig in low for sig in _TERMINATION_SIGNALS)
+
