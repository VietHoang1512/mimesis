--- a/gyms/SearchGym/searchgym/utils.py
+++ b/gyms/SearchGym/searchgym/utils.py
@@ -28,11 +28,39 @@ def get_serper_api_key():
     if api_key:
         return api_key
     
+    if OFFLINE:
+        # SEARCH_OFFLINE=1: no key needed, and none will be used. Returning a
+        # sentinel rather than raising is what makes the gym IMPORTABLE -- this
+        # function runs at module import (below), so without it `bamboogle`
+        # cannot even be loaded, let alone evaluated.
+        return "__offline__"
     raise ValueError("Serper API key not found. Please provide it in secret.json or SERPER_API_KEY environment variable.")
 
+
+# ── offline / closed-book mode ───────────────────────────────────────────────
+# SEARCH_OFFLINE=1 runs SearchGym with the search tool stubbed out, turning it
+# into a closed-book two-hop QA eval. Scoring is untouched: Bamboogle ships gold
+# answers and _handle_answer_action compares against them without consulting
+# search at all. search_serper() returns OFFLINE_NOTICE for every query.
+#
+# The stub text matters more than it looks. When a call fails instead of being
+# stubbed -- an expired or exhausted key -- it raises, _handle_search_action
+# catches the error and hands back "Search failed: ...", and the agent, with
+# no way to know the tool is permanently gone, retries until its turn budget
+# is spent. The eval then measures retry behaviour under a broken tool rather
+# than the task itself. Stating the unavailability plainly, once, lets the
+# agent stop and answer, which is the behaviour a closed-book score is meant
+# to reflect.
+OFFLINE = os.getenv("SEARCH_OFFLINE", "0") == "1"
+OFFLINE_NOTICE = os.getenv(
+    "SEARCH_OFFLINE_NOTICE",
+    "Search is unavailable in this evaluation. No results can be retrieved, and "
+    "retrying will not help. Answer the question from your own knowledge.",
+)
+
 api_key = get_serper_api_key()
 
-conn = http.client.HTTPSConnection("google.serper.dev")
+conn = None if OFFLINE else http.client.HTTPSConnection("google.serper.dev")
 headers = {
   'X-API-KEY': api_key,
   'Content-Type': 'application/json'
@@ -56,6 +84,10 @@ def _slog(msg):
 _call_count = 0
 
 def search_serper(query, num=10):
+    if OFFLINE:
+        # One stable observation, not an error: see OFFLINE_NOTICE above.
+        return OFFLINE_NOTICE
+
     # Handle mock API key for testing
     if api_key == "mock_api_key_for_testing":
         return f"Mock search results for '{query}':\n1. Mock Result 1\n- Snippet: This is a mock search result for testing purposes.\n2. Mock Result 2\n- Snippet: Another mock result to demonstrate the search functionality."
