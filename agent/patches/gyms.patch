+def _coerce_model_json(response_text, keys=()):
+    """Parse model output that is *meant* to be JSON but often is not.
+
+    json.loads and literal_eval both reject two shapes the model emits often,
+    which is what the extra tiers below exist for:
+      * curly quotes as delimiters -- {\u2018response\u2019: \u2018...\u2019}
+        -> "invalid character '\u2019' (U+2019)"
+      * single-quoted dicts whose values contain apostrophes -- {'response':
+        'I'm glad'} -> "unterminated string literal" / "invalid syntax"
+    A parse failure here is silent: the caller substitutes a canned reply
+    carrying 0.0 reward, so the gym scores zero on a turn the simulator answered.
+
+    Four tiers, cheapest first. The last one does not parse structure at all --
+    it pulls the named keys out with a regex, which survives any quoting the
+    model invents.
+    """
+    import json as _json
+    import re as _re
+    from ast import literal_eval as _le
+
+    t = (response_text or "").strip()
+    if t.startswith("```"):
+        t = t.split("\n", 1)[-1] if "\n" in t else t[3:]
+    if t.endswith("```"):
+        t = t[:-3]
+    # Normalise typographic punctuation to ASCII. Safe here: this is a data
+    # payload, not prose we must preserve byte-for-byte.
+    t = (t.replace("\u2018", "'").replace("\u2019", "'")
+          .replace("\u201c", '"').replace("\u201d", '"').strip())
+    a, b = t.find("{"), t.rfind("}")
+    if a != -1 and b > a:
+        t = t[a:b + 1]
+
+    for attempt in (lambda: _json.loads(t), lambda: _le(t)):
+        try:
+            out = attempt()
+            if isinstance(out, dict):
+                return out
+        except Exception:
+            pass
+
+    # Last resort: lift each key's value directly. Tolerates unescaped quotes,
+    # apostrophes and newlines inside the value because it anchors on the NEXT
+    # key or the closing brace rather than on a quote character.
+    if keys:
+        got, ks = {}, list(keys)
+        for k in ks:
+            others = "|".join(_re.escape(o) for o in ks if o != k)
+            stop = rf'(?=\s*,\s*["\']?(?:{others})["\']?\s*:|\s*\}}\s*$)' if others else r'(?=\s*\}}\s*$)'
+            m = _re.search(rf'["\']?{_re.escape(k)}["\']?\s*:\s*["\']?(.*?)["\']?\s*{stop}',
+                           t, _re.S)
+            if m:
+                got[k] = m.group(1).strip()
+        if got:
+            return got
+    raise ValueError(f"could not parse model output as JSON: {t[:120]!r}")
+
 def parse_llm_response(response_text: str) -> Tuple[str, str, Dict[str, Any]]:
     """Parse LLM response to extract feedback, stance, and full JSON."""
